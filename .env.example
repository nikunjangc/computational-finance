# Copy to `.env` and fill in what you have. Anything left blank disables that
# connector/notifier. Load it with e.g. `export $(grep -v '^#' .env | xargs)`
# or a tool like `direnv` / `python-dotenv`. DO NOT commit your real .env.

# ---------- Notifications ----------
# Telegram (recommended, free): create a bot via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp: choose provider "twilio" or "meta".
WHATSAPP_PROVIDER=twilio
# Twilio WhatsApp sandbox:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX
# Meta/WhatsApp Cloud API (if WHATSAPP_PROVIDER=meta):
META_WA_TOKEN=
META_WA_PHONE_ID=

# ---------- Sources ----------
# Comma-separated YouTube video/live IDs or URLs (CNBC, Yahoo Finance, etc.)
YOUTUBE_CHANNELS=
YOUTUBE_API_KEY=
# Crypto "coin index" (CoinGecko ids), and the 24h % move that triggers an alert.
CRYPTO_SYMBOLS=bitcoin,ethereum
CRYPTO_MOVE_PCT=3.0
# Generic websocket push feeds (your transcription relay / news socket).
WEBSOCKET_URLS=

# ---------- Engine ----------
MIN_CONFIDENCE=0.45
POLL_SECONDS=20

# ---------- Multi-instance (primary + failover) ----------
# Role-based mode (no extra services): run the main host as primary and the
# backup host (e.g. GCP e2-micro) as standby. Standby processes everything but
# stays SILENT, so you never get double alerts. If the primary dies, change the
# standby's TRACKER_ROLE to primary (or just leave it running and promote it).
INSTANCE_ID=                 # optional label; defaults to hostname-pid
TRACKER_ROLE=primary         # primary | standby
# Automatic mode (optional): set REDIS_URL to a shared Redis (e.g. free Upstash).
# A leader lease auto-fails-over within LEASE_TTL seconds and a shared dedup key
# guarantees exactly one alert per event — safe to run both hosts active.
REDIS_URL=                   # e.g. rediss://default:<pass>@<host>:<port>
LEASE_TTL=30
DEDUP_WINDOW=900

# ---------- Container resource cap (docker compose) ----------
# Safety ceiling for the container. The agent normally uses <0.5 CPU / <200 MB,
# so these defaults are generous. Exceeding MEM_LIMIT => OOM-killed (hard fail)
# then auto-restarted. Stay within your VM shape AND the Oracle free tier.
# NOTE: as of ~June 15 2026 Oracle's Always Free Ampere A1 ceiling is
# 2 OCPU / 12 GB total (halved from the old 4 OCPU / 24 GB).
# Free-tier ceiling example: CPU_LIMIT=2.0  MEM_LIMIT=12g
CPU_LIMIT=1.0
MEM_LIMIT=1g
MEM_RESERVE=128m
